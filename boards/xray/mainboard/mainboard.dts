/*
 * X-Ray Main Board: custom PCB with an STM32G491MET6 (LQFP80).
 * Pins and clocks come from MainBoard.ioc.
 */

/dts-v1/;
#include <st/g4/stm32g491Xe.dtsi>
#include <st/g4/stm32g491m(c-e)tx-pinctrl.dtsi>

/ {
	model = "X-Ray Main Board (STM32G491ME)";

	chosen {
		zephyr,console = &lpuart1;
		zephyr,shell-uart = &lpuart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	leds {
		compatible = "gpio-leds";
		status_led: status_led {
			gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;	/* FW_STATUS_LED */
			label = "FW_STATUS_LED";
		};
		green_led: green_led {
			gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>;	/* LED_GREEN */
			label = "LED_GREEN";
		};
		red_led: red_led {
			gpios = <&gpioe 14 GPIO_ACTIVE_HIGH>;	/* LED_RED */
			label = "LED_RED";
		};
		yellow_led: yellow_led {
			gpios = <&gpioe 15 GPIO_ACTIVE_HIGH>;	/* LED_YELLOW */
			label = "LED_YELLOW";
		};
	};

	aliases {
		led0 = &status_led;
		led1 = &green_led;
		led2 = &red_led;
		led3 = &yellow_led;
	};
};

/* 24 MHz crystal on PF0/PF1 (HSE_IN / HSE_OUT) */
&clk_hse {
	clock-frequency = <DT_FREQ_M(24)>;
	status = "okay";
};

/* 24 MHz / 6 = 4 MHz, x 85 = 340 MHz, / 2 = 170 MHz (same as MainBoard.ioc) */
&pll {
	div-m = <6>;
	mul-n = <85>;
	div-p = <7>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(170)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

/* Debug UART: DBG_TX = PA2, DBG_RX = PA3 */
&lpuart1 {
	pinctrl-0 = <&lpuart1_tx_pa2 &lpuart1_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};
